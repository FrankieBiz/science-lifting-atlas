---
import posterUrl from '../../assets/derived/bodyparts3d/sbla005-poster.webp?url';
import { getCollection } from 'astro:content';
import AtlasLayout from '../layouts/AtlasLayout.astro';
import { prototypePreviewEnabled } from '../lib/presentation/sbla012';

const prototypeEnabled = prototypePreviewEnabled(process.env);
const [claims, sources, exercises] = await Promise.all([
  getCollection('claims'),
  getCollection('sources'),
  getCollection('exercises'),
]);
const reviewedClaimCount = claims.filter(
  ({ data }) => data.reviewState === 'approved',
).length;
---

<AtlasLayout
  title="Science-Based Lifting Atlas"
  description="Evidence-first resistance training anatomy — a visual evidence graph."
  current="home"
>
  <section class="home-hero" aria-labelledby="page-title">
    <div class="home-hero__copy">
      <p class="micro-label">An evidence system for resistance training</p>
      <h1 id="page-title">Know what<br />you’re <em>training.</em></h1>
      <p class="home-hero__lede">
        Trace a muscle to the movements that train it—and every practical
        takeaway back to its exact evidence, limits, and uncertainty.
      </p>
      <div class="home-hero__actions">
        {
          prototypeEnabled ? (
            <a
              class="button button--primary"
              href="./muscles/pectoralis-major/"
            >
              Explore the first evidence chain <span aria-hidden="true">↗</span>
            </a>
          ) : (
            <span class="button button--disabled" aria-disabled="true">
              First evidence chain in review
            </span>
          )
        }
        <a class="button button--quiet" href="./methodology/">
          See how claims are built
        </a>
      </div>
      <dl class="home-hero__metrics" aria-label="Current atlas status">
        <div><dt>{reviewedClaimCount}</dt><dd>reviewed claims</dd></div>
        <div><dt>{sources.length}</dt><dd>source records</dd></div>
        <div><dt>{exercises.length}</dt><dd>movement records</dd></div>
      </dl>
    </div>

    <figure class="home-hero__visual">
      <div class="home-hero__visual-grid" aria-hidden="true"></div>
      <img
        src={posterUrl}
        width="800"
        height="1000"
        alt="BodyParts3D anterior muscular-system render used as a non-interactive two-dimensional fallback."
      />
      <svg viewBox="0 0 720 760" aria-hidden="true">
        <path
          class="focus-shape"
          d="M281 251c35-18 61-13 77 10v74c-41 13-72-3-93-49 2-15 7-27 16-35Zm158 0c-35-18-61-13-77 10v74c41 13 72-3 93-49-2-15-7-27-16-35Z"
        ></path>
        <path class="focus-line" d="M447 279h126l28-34"></path>
        <circle class="focus-node" cx="447" cy="279" r="5"></circle>
      </svg>
      <div class="home-hero__focus-card">
        <p>Current slice <span>01</span></p>
        <h2>
          {
            prototypeEnabled ? (
              <a href="./muscles/pectoralis-major/">Pectoralis major</a>
            ) : (
              'Pectoralis major'
            )
          }
        </h2>
        <div>
          <span>Structure</span><span>{exercises.length} movements</span><span
            >{reviewedClaimCount} claims</span
          >
        </div>
      </div>
      <figcaption class="home-hero__attribution">
        BodyParts3D, © The Database Center for Life Science licensed under CC
        Attribution 4.0 International · 2D fallback is authoritative
      </figcaption>
    </figure>
  </section>

  <section
    id="evidence-trace"
    class="evidence-trace"
    aria-labelledby="trace-title"
  >
    <header>
      <p class="micro-label">One connected answer</p>
      <h2 id="trace-title">From anatomy to evidence.</h2>
      <p>
        The Atlas is not an exercise list. It is a chain you can inspect in
        either direction.
      </p>
    </header>
    <ol>
      <li>
        <span class="trace-number">01</span>
        <span class="trace-type">Structure</span>
        <strong>
          {
            prototypeEnabled ? (
              <a href="./muscles/pectoralis-major/">Pectoralis major</a>
            ) : (
              'Pectoralis major'
            )
          }
        </strong>
        <small>What it is and what it does</small>
      </li>
      <li>
        <span class="trace-number">02</span>
        <span class="trace-type">Movement</span>
        <strong>
          {
            prototypeEnabled ? (
              <a href="./exercises/barbell-flat-bench-press/">
                Barbell flat bench press
              </a>
            ) : (
              'Barbell flat bench press'
            )
          }
        </strong>
        <small>Scope, mechanics, and limits</small>
      </li>
      <li>
        <span class="trace-number">03</span>
        <span class="trace-type">Evidence</span>
        <strong>Claim-level source trail</strong>
        <small>Certainty, qualifiers, exact locators</small>
      </li>
    </ol>
  </section>

  <section class="home-principles" aria-labelledby="principles-title">
    <header>
      <p class="micro-label">Built for skeptical lifters</p>
      <h2 id="principles-title">Useful first. Auditable always.</h2>
    </header>
    <div>
      <article>
        <span>01</span>
        <h3>Practical language</h3>
        <p>
          Start with the answer a lifter needs, without pretending it is
          universal.
        </p>
      </article>
      <article>
        <span>02</span>
        <h3>Visible uncertainty</h3>
        <p>
          Mixed evidence and important limits stay attached to the takeaway.
        </p>
      </article>
      <article>
        <span>03</span>
        <h3>Exact source trails</h3>
        <p>
          Every scientific statement can be followed back to the records behind
          it.
        </p>
      </article>
    </div>
  </section>
</AtlasLayout>
