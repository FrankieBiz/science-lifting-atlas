---
import { getCollection, type CollectionEntry } from 'astro:content';

import PrototypeBanner from '../../components/sbla-012/PrototypeBanner.astro';
import AtlasLayout from '../../layouts/AtlasLayout.astro';
import {
  classifyPreviewRecord,
  prototypePreviewEnabled,
} from '../../lib/presentation/sbla012';

type Source = CollectionEntry<'sources'>['data'];
type EvidenceRole =
  'supports' | 'qualifies' | 'contradicts' | 'neutral-context';
type ReferencingClaim = Readonly<{
  id: string;
  plainLanguage: string;
  role: EvidenceRole;
  entities: ReadonlyArray<{
    href: string;
    label: string;
  }>;
}>;

export async function getStaticPaths() {
  const prototypeEnabled = prototypePreviewEnabled(process.env);
  if (!prototypeEnabled) return [];

  const [claims, sources, muscles, exercises] = await Promise.all([
    getCollection('claims'),
    getCollection('sources'),
    getCollection('muscles'),
    getCollection('exercises'),
  ]);
  const prototypeClaims = claims.filter(
    (entry) =>
      classifyPreviewRecord(entry.data, prototypeEnabled) === 'prototype',
  );
  const entitiesByClaimId = new Map<
    string,
    Array<{ href: string; label: string }>
  >();

  for (const entity of [
    ...muscles.map((entry) => ({ kind: 'muscles', data: entry.data })),
    ...exercises.map((entry) => ({ kind: 'exercises', data: entry.data })),
  ]) {
    if (classifyPreviewRecord(entity.data, prototypeEnabled) !== 'prototype') {
      continue;
    }
    const claimIds = new Set([
      ...entity.data.summaryClaimIds,
      ...entity.data.sections.flatMap((section) => section.claimIds),
    ]);
    for (const claimId of claimIds) {
      const backlinks = entitiesByClaimId.get(claimId) ?? [];
      backlinks.push({
        href: `../../${entity.kind}/${entity.data.slug}/#claim-${claimId}`,
        label: entity.data.name,
      });
      entitiesByClaimId.set(claimId, backlinks);
    }
  }

  return sources.flatMap((entry) => {
    const referencingClaims = prototypeClaims.flatMap((claim) =>
      claim.data.sourceLinks
        .filter((link) => link.sourceId === entry.data.id)
        .map((link) => ({
          id: claim.data.id,
          plainLanguage: claim.data.plainLanguage,
          role: link.role,
          entities: entitiesByClaimId.get(claim.data.id) ?? [],
        })),
    );
    if (referencingClaims.length === 0) return [];
    return [
      {
        params: { sourceId: entry.data.id },
        props: { source: entry.data, referencingClaims },
      },
    ];
  });
}

interface Props {
  source: Source;
  referencingClaims: ReferencingClaim[];
}

const { source, referencingClaims } = Astro.props;
const externalHref =
  source.urls.doi ?? source.urls.pubmed ?? source.urls.primary;
const authorLine =
  source.authors.length > 0
    ? source.authors.join(', ')
    : 'Institutional or unattributed record';
const primaryIdentifier = source.identifiers.doi
  ? `DOI ${source.identifiers.doi}`
  : source.identifiers.pmid
    ? `PMID ${source.identifiers.pmid}`
    : source.identifiers.pmcid
      ? source.identifiers.pmcid
      : source.identifiers.isbn
        ? `ISBN ${source.identifiers.isbn}`
        : source.id;
const roleOrder: EvidenceRole[] = [
  'supports',
  'qualifies',
  'contradicts',
  'neutral-context',
];
const roleDescriptions: Record<EvidenceRole, string> = {
  supports: 'Directly contributes to the claim.',
  qualifies: 'Narrows how confidently the claim can be read.',
  contradicts: 'Reports evidence that points against the claim.',
  'neutral-context': 'Adds context without deciding the claim.',
};
const roleCounts = new Map<EvidenceRole, number>();
for (const claim of referencingClaims) {
  roleCounts.set(claim.role, (roleCounts.get(claim.role) ?? 0) + 1);
}
const activeRoles = roleOrder.filter((role) => roleCounts.has(role));
const formatToken = (value: string) => value.replaceAll('-', ' ');
---

<AtlasLayout
  title={source.title}
  description="Local review prototype source record."
  current="entity"
  noindex
>
  <PrototypeBanner />
  <article class="source-page source-dossier">
    <header class="source-page__header source-dossier__header">
      <div class="source-dossier__identity">
        <p class="micro-label">Research dossier / {primaryIdentifier}</p>
        <ul class="source-dossier__flags" aria-label="Source classifications">
          <li>{formatToken(source.type)}</li>
          <li>{formatToken(source.publication.stage)}</li>
          <li data-status={source.publication.status}>
            {formatToken(source.publication.status)}
          </li>
        </ul>
        <h1>{source.title}</h1>
        <p class="source-dossier__citation">{authorLine} · {source.year}</p>
        {
          externalHref && (
            <a class="source-dossier__primary-link" href={externalHref}>
              Read the source record <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>

      <aside class="source-dossier__readout" aria-labelledby="readout-title">
        <p class="micro-label">Dossier readout</p>
        <h2 id="readout-title">How this record enters the atlas.</h2>
        <dl>
          <div>
            <dt>Claim connections</dt>
            <dd>{String(referencingClaims.length).padStart(2, '0')}</dd>
          </div>
          <div>
            <dt>Evidence roles</dt>
            <dd>{String(activeRoles.length).padStart(2, '0')}</dd>
          </div>
          <div>
            <dt>Applicability</dt>
            <dd>{formatToken(source.quality.applicability)}</dd>
          </div>
          <div>
            <dt>Risk of bias</dt>
            <dd>{formatToken(source.quality.riskOfBias)}</dd>
          </div>
          <div>
            <dt>Access</dt>
            <dd>{formatToken(source.access.level)}</dd>
          </div>
          <div>
            <dt>Status checked</dt>
            <dd>{source.publication.statusCheckedAt ?? 'Not recorded'}</dd>
          </div>
        </dl>
      </aside>
    </header>

    <section
      class="source-page__summary source-dossier__contribution"
      aria-labelledby="source-summary-title"
    >
      <p class="micro-label">Project extraction</p>
      <div>
        <h2 id="source-summary-title">What this source contributes.</h2>
        <p>{source.projectSummary}</p>
      </div>
      <dl aria-label="Evidence-role balance">
        {
          activeRoles.map((role) => (
            <div data-role={role}>
              <dt>{formatToken(role)}</dt>
              <dd>{String(roleCounts.get(role)).padStart(2, '0')}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section
      class="source-page__methods source-dossier__methods"
      aria-labelledby="methods-title"
    >
      <header>
        <div>
          <p class="micro-label">Study register</p>
          <h2 id="methods-title">Read the method before the result.</h2>
        </div>
        <p>
          The atlas keeps study design, applicability, and review caveats next
          to every downstream claim. Missing fields are named rather than
          inferred.
        </p>
      </header>
      <dl class="source-dossier__method-grid">
        <div class="source-dossier__method-grid__wide">
          <dt>Population or evidence base</dt><dd>{source.study.population}</dd>
        </div>
        <div><dt>Intervention</dt><dd>{source.study.intervention}</dd></div>
        <div><dt>Comparator</dt><dd>{source.study.comparator}</dd></div>
        <div>
          <dt>Sample size</dt><dd>
            {source.study.sampleSize ?? 'Not reported'}
          </dd>
        </div>
        <div>
          <dt>Duration</dt><dd>
            {
              source.study.durationWeeks
                ? `${source.study.durationWeeks} weeks`
                : 'Not reported or not applicable'
            }
          </dd>
        </div>
      </dl>

      <div class="source-dossier__context-band">
        <section aria-labelledby="outcomes-title">
          <p class="micro-label" id="outcomes-title">Extracted outcomes</p>
          <ul class="source-dossier__outcomes">
            {source.study.outcomes.map((outcome) => <li>{outcome}</li>)}
          </ul>
        </section>
        <dl>
          <div>
            <dt>Funding disclosure</dt>
            <dd>{source.funding ?? 'Not reported in this record'}</dd>
          </div>
          <div>
            <dt>Conflict disclosure</dt>
            <dd>{source.conflicts ?? 'Not reported in this record'}</dd>
          </div>
          <div>
            <dt>License</dt>
            <dd>{source.access.license ?? 'No license recorded'}</dd>
          </div>
          <div>
            <dt>Next status check</dt>
            <dd>{source.publication.nextStatusCheckAt ?? 'Not scheduled'}</dd>
          </div>
        </dl>
      </div>

      <details class="source-dossier__limitations">
        <summary>
          <span>Quality notes and extraction limits</span>
          <span>{String(source.quality.notes.length).padStart(2, '0')}</span>
        </summary>
        <ol>{source.quality.notes.map((note) => <li>{note}</li>)}</ol>
        {
          source.publication.statusSource && (
            <p>
              <strong>Status source:</strong> {source.publication.statusSource}
            </p>
          )
        }
      </details>
    </section>

    <section
      class="source-page__claims source-dossier__claims"
      aria-labelledby="claims-title"
    >
      <header>
        <div>
          <p class="micro-label">
            Reverse evidence trace / {
              String(referencingClaims.length).padStart(2, '0')
            }
          </p>
          <h2 id="claims-title">Where this record changes the atlas.</h2>
        </div>
        <p>
          Each connection names the source's role. Follow a backlink to see the
          claim in its muscle or exercise context.
        </p>
      </header>

      <ul class="source-dossier__role-key" aria-label="Evidence-role key">
        {
          activeRoles.map((role) => (
            <li data-role={role}>
              <span>
                {formatToken(role)} · {roleCounts.get(role)}
              </span>
              <small>{roleDescriptions[role]}</small>
            </li>
          ))
        }
      </ul>

      <ol>
        {
          referencingClaims.map((claim, index) => (
            <li data-role={claim.role}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <header>
                  <strong>{formatToken(claim.role)}</strong>
                  <small>{claim.id}</small>
                </header>
                <p>{claim.plainLanguage}</p>
                {claim.entities.length > 0 && (
                  <nav aria-label={`Return to records for ${claim.id}`}>
                    <span>See in context</span>
                    {claim.entities.map((entity) => (
                      <a href={entity.href}>{entity.label} ↗</a>
                    ))}
                  </nav>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </article>
</AtlasLayout>

<style>
  .source-dossier {
    --dossier-gutter: max(1.5rem, calc((100vw - var(--content)) / 2));
  }

  .source-dossier__header {
    min-height: 0;
    grid-template-columns: minmax(0, 1.28fr) minmax(19rem, 0.72fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: start;
    padding: clamp(4rem, 7vw, 6.5rem) var(--dossier-gutter);
    background:
      linear-gradient(135deg, rgb(85 199 216 / 7%), transparent 38%),
      var(--ink-950);
  }

  .source-dossier__identity {
    min-width: 0;
  }

  .source-dossier__flags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .source-dossier__flags li {
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--rule-strong);
    color: var(--mist-300);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .source-dossier__flags li[data-status='current'] {
    border-color: rgb(145 225 234 / 38%);
    color: var(--signal-300);
  }

  .source-dossier__header h1 {
    max-width: 18ch;
    margin: 1.35rem 0 1.15rem;
    font-size: clamp(2.65rem, 4.7vw, 5.2rem);
    letter-spacing: -0.06em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .source-dossier__citation {
    max-width: 64ch;
    margin: 0;
    color: var(--mist-300);
    font-family: var(--font-serif);
    font-size: clamp(1rem, 1.5vw, 1.25rem);
  }

  .source-dossier__primary-link {
    width: fit-content;
    min-height: 2.8rem;
    display: inline-flex;
    gap: 2rem;
    align-items: center;
    margin-top: 2rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--rule-strong);
    color: var(--paper-50);
    font-size: 0.76rem;
    font-weight: 750;
    text-decoration: none;
  }

  .source-dossier__primary-link:hover {
    border-color: var(--signal-300);
  }

  .source-dossier__primary-link span {
    color: var(--signal-300);
  }

  .source-dossier__readout {
    padding: clamp(1.5rem, 3vw, 2.2rem);
    border: 1px solid var(--rule-strong);
    border-top: 3px solid var(--tissue-500);
    background: rgb(17 22 25 / 78%);
    box-shadow: var(--shadow-deep);
  }

  .source-dossier__readout h2 {
    max-width: 15ch;
    margin: 0.8rem 0 1.8rem;
    font-size: clamp(1.65rem, 2.8vw, 2.45rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .source-dossier__readout dl {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-color: var(--rule);
  }

  .source-dossier__readout dl > div {
    min-height: 0;
    padding: 0.9rem;
    border-color: var(--rule);
    background: transparent;
  }

  .source-dossier__readout dd {
    overflow-wrap: anywhere;
    color: var(--paper-50);
    font-size: 0.86rem;
    font-weight: 700;
    text-transform: capitalize;
  }

  .source-dossier__contribution {
    grid-template-columns: minmax(9rem, 0.24fr) minmax(20rem, 1fr) minmax(
        12rem,
        0.34fr
      );
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
  }

  .source-dossier__contribution h2 {
    max-width: 17ch;
    margin: 0 0 1.4rem;
    font-size: clamp(2.2rem, 3.7vw, 4rem);
  }

  .source-dossier__contribution > div > p {
    max-width: 74ch;
    margin: 0;
    color: var(--ink-700);
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    line-height: 1.65;
  }

  .source-dossier__contribution > dl {
    display: grid;
    margin: 0;
    border-top: 2px solid var(--ink-950);
  }

  .source-dossier__contribution > dl > div {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.8rem 0;
    border-bottom: 1px solid rgb(11 14 16 / 18%);
  }

  .source-dossier__contribution dt {
    margin: 0;
    color: var(--ink-700);
  }

  .source-dossier__contribution dd {
    color: var(--ink-950);
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 750;
  }

  .source-dossier__methods,
  .source-dossier__claims {
    padding: clamp(4rem, 7vw, 6.5rem) var(--dossier-gutter);
  }

  .source-dossier__methods > header,
  .source-dossier__claims > header {
    grid-template-columns: minmax(20rem, 0.95fr) minmax(18rem, 0.65fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
    margin-bottom: 3rem;
  }

  .source-dossier__methods > header h2,
  .source-dossier__claims > header h2 {
    margin-top: 0.9rem;
    font-size: clamp(2.4rem, 4.2vw, 4.6rem);
  }

  .source-dossier__methods > header > p,
  .source-dossier__claims > header > p {
    max-width: 42ch;
    margin: 0;
    color: var(--mist-300);
  }

  .source-dossier__method-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-color: var(--rule-strong);
  }

  .source-dossier__method-grid > div {
    min-height: 0;
    padding: clamp(1.2rem, 2.5vw, 2rem);
    border-color: var(--rule-strong);
    background: var(--panel);
  }

  .source-dossier__method-grid .source-dossier__method-grid__wide {
    grid-column: 1 / -1;
  }

  .source-dossier__method-grid dd {
    max-width: 68ch;
    color: var(--mist-300);
    line-height: 1.6;
  }

  .source-dossier__context-band {
    display: grid;
    grid-template-columns: minmax(16rem, 0.55fr) minmax(20rem, 1.45fr);
    margin-top: 1rem;
    border: 1px solid var(--rule-strong);
  }

  .source-dossier__context-band > section {
    padding: clamp(1.3rem, 2.5vw, 2rem);
    border-right: 1px solid var(--rule-strong);
  }

  .source-dossier__outcomes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .source-dossier__outcomes li {
    margin: 0;
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--rule-strong);
    color: var(--paper-100);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .source-dossier__context-band > dl {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 0;
  }

  .source-dossier__context-band > dl > div {
    min-height: 0;
    padding: 1.3rem;
    border-color: var(--rule-strong);
    background: transparent;
  }

  .source-dossier__context-band dd {
    color: var(--mist-300);
    font-size: 0.86rem;
  }

  .source-dossier__limitations {
    margin-top: 1rem;
    border: 1px solid var(--rule-strong);
    background: var(--panel);
  }

  .source-dossier__limitations summary {
    display: flex;
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.3rem;
    color: var(--paper-100);
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 750;
    list-style: none;
  }

  .source-dossier__limitations summary::-webkit-details-marker {
    display: none;
  }

  .source-dossier__limitations summary span:last-child {
    color: var(--tissue-300);
    font-family: var(--font-mono);
  }

  .source-dossier__limitations ol {
    margin: 0;
    padding: 0 2.5rem 1.5rem 3.5rem;
  }

  .source-dossier__limitations li {
    max-width: 90ch;
    margin-block: 0.9rem;
    padding-left: 0.6rem;
    color: var(--mist-300);
  }

  .source-dossier__limitations > p {
    max-width: 90ch;
    margin: 0;
    padding: 1.4rem;
    border-top: 1px solid var(--rule);
    color: var(--mist-500);
    font-size: 0.78rem;
  }

  .source-dossier__role-key {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    margin: 0 0 1rem;
    padding: 0;
    border: 1px solid var(--rule-strong);
    list-style: none;
  }

  .source-dossier__role-key li {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 1rem 1.2rem;
    border-right: 1px solid var(--rule);
  }

  .source-dossier__role-key span {
    color: var(--signal-300);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .source-dossier__role-key li[data-role='contradicts'] span {
    color: var(--tissue-300);
  }

  .source-dossier__role-key small {
    color: var(--mist-500);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .source-dossier__claims > ol > li {
    grid-template-columns: 3.5rem 1fr;
    border: 1px solid var(--rule-strong);
    border-top-width: 3px;
    background: var(--panel);
  }

  .source-dossier__claims > ol > li + li {
    margin-top: 0.75rem;
  }

  .source-dossier__claims > ol > li[data-role='supports'] {
    border-top-color: var(--signal-500);
  }

  .source-dossier__claims > ol > li[data-role='contradicts'] {
    border-top-color: var(--tissue-500);
  }

  .source-dossier__claims > ol > li > span {
    padding: 1.5rem 0.3rem;
    color: var(--mist-500);
  }

  .source-dossier__claims > ol > li > div {
    padding: clamp(1.3rem, 3vw, 2.2rem);
  }

  .source-dossier__claims > ol header {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }

  .source-dossier__claims > ol strong {
    color: var(--signal-300);
  }

  .source-dossier__claims > ol li[data-role='contradicts'] strong {
    color: var(--tissue-300);
  }

  .source-dossier__claims > ol header small {
    overflow-wrap: anywhere;
    color: var(--mist-500);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .source-dossier__claims > ol p {
    max-width: 72ch;
    margin: 1.15rem 0 0;
    color: var(--paper-100);
    font-size: clamp(1.12rem, 1.6vw, 1.4rem);
    line-height: 1.55;
  }

  .source-dossier__claims > ol nav {
    align-items: center;
    margin-top: 1.3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .source-dossier__claims > ol nav span {
    color: var(--mist-500);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 62rem) {
    .source-dossier__header,
    .source-dossier__contribution,
    .source-dossier__methods > header,
    .source-dossier__claims > header,
    .source-dossier__context-band {
      grid-template-columns: 1fr;
    }

    .source-dossier__context-band > section {
      border-right: 0;
      border-bottom: 1px solid var(--rule-strong);
    }

    .source-dossier__contribution > dl {
      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    }
  }

  @media (max-width: 44rem) {
    .source-dossier__header h1 {
      font-size: clamp(2.6rem, 13vw, 4rem);
    }

    .source-dossier__readout dl,
    .source-dossier__method-grid,
    .source-dossier__context-band > dl {
      grid-template-columns: 1fr;
    }

    .source-dossier__method-grid .source-dossier__method-grid__wide {
      grid-column: auto;
    }

    .source-dossier__claims > ol > li {
      grid-template-columns: 2.2rem 1fr;
    }

