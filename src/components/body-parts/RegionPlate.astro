---
import posterUrl from '../../../assets/derived/bodyparts3d/anatomy-explorer-poster.png?url';
import type { BodyPart } from '../../data/body-parts';

interface Props {
  part: BodyPart;
  variant: 'hero' | 'card';
}

const { part, variant } = Astro.props;
// Poster is 862 × 672. The plate crops it so the region sits at the centre.
const POSTER_RATIO = 672 / 862;
const plateRatio = variant === 'hero' ? 5 / 4 : 3 / 4;
const zoom = variant === 'hero' ? part.focus.zoom : part.focus.zoom * 0.85;
const width = zoom * 100;
const left = 50 - (part.focus.x / 100) * width;
const top =
  50 - ((part.focus.y / 100) * zoom * POSTER_RATIO * 100) / plateRatio;
---

<figure
  class:list={['region-plate', `region-plate--${variant}`]}
  style={`--plate-ratio: ${1 / plateRatio}`}
>
  <img
    src={posterUrl}
    alt=""
    width="862"
    height="672"
    loading={variant === 'hero' ? 'eager' : 'lazy'}
    style={`width: ${width.toFixed(2)}%; left: ${left.toFixed(2)}%; top: ${top.toFixed(2)}%`}
  />
  <span class="region-plate__ring" aria-hidden="true"></span>
  {
    variant === 'hero' && (
      <figcaption>
        <span class="region-plate__dot" aria-hidden="true" />
        {part.name} · anterior view
      </figcaption>
    )
  }
</figure>
