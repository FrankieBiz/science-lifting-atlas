---
import type { BodyPart } from '../../data/body-parts/index.ts';
import { POSTERS, plateImageStyle } from '../../lib/body-parts/plate.ts';
import { HOME_POSTER_SIZES, posterImage } from './poster-image.ts';

interface Props {
  part: BodyPart;
  variant: 'hero' | 'card';
}

const { part, variant } = Astro.props;
// The plate crops the poster so the region sits at the centre.
const plateRatio = variant === 'hero' ? 5 / 4 : 3 / 4;
const zoom = variant === 'hero' ? part.plate.zoom : part.plate.zoom * 0.85;
const view = part.plate.view;
// The hero image is `zoom` times the plate width, which follows the layout.
// Cards appear only on the home page and share its poster files.
const sizes =
  variant === 'hero'
    ? `(max-width: 62rem) calc(${zoom} * 100vw), calc(${zoom} * min(42vw, 34rem))`
    : HOME_POSTER_SIZES;
const poster = await posterImage(view, sizes);
const { width, left, top } = plateImageStyle(
  part.plate,
  zoom,
  plateRatio,
  POSTERS[view],
);
---

<figure
  class:list={['region-plate', `region-plate--${variant}`]}
  style={`--plate-ratio: ${1 / plateRatio}`}
>
  <img
    {...poster}
    alt=""
    loading={variant === 'hero' ? 'eager' : 'lazy'}
    style={`width: ${width.toFixed(2)}%; left: ${left.toFixed(2)}%; top: ${top.toFixed(2)}%`}
  />
  <span class="region-plate__ring" aria-hidden="true"></span>
  {
    variant === 'hero' && (
      <figcaption>
        <span class="region-plate__dot" aria-hidden="true" />
        {part.name} · {view} view
      </figcaption>
    )
  }
</figure>
