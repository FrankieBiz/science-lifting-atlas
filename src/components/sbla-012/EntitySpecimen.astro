---
import bodyPoster from '../../../assets/derived/bodyparts3d/sbla005-poster.webp?url';

interface Props {
  category: string;
  index: string;
  name: string;
  descriptor: string;
}

const { category, name, descriptor } = Astro.props;
const isExercise = category.toLowerCase() === 'exercise';
---

<header class="entity-hero">
  <div class="entity-hero__title">
    <p class="micro-label">{category} record</p>
    <h1>{name}</h1>
    <p>{descriptor}</p>
    <nav class="entity-hero__signals" aria-label="On this record">
      <a class="button button--primary" href="#summary-title">Key takeaways</a>
      <a class="button button--quiet" href="#evidence-spine-title"
        >Explore evidence <span aria-hidden="true">›</span></a
      >
    </nav>
  </div>

  <figure
    class:list={[
      'entity-hero__specimen',
      isExercise && 'entity-hero__specimen--exercise',
    ]}
  >
    {
      isExercise ? (
        <svg
          class="movement-diagram"
          viewBox="0 0 640 520"
          role="img"
          aria-label="Abstract static movement-path diagram for the exercise record."
        >
          <path
            class="movement-diagram__bench"
            d="M150 356h340M216 356l-42 92M426 356l42 92"
          />
          <path
            class="movement-diagram__body"
            d="M229 324c44-56 138-66 190-10l-14 37H216Z"
          />
          <path
            class="movement-diagram__bar"
            d="M92 193h456M116 166v54M524 166v54"
          />
          <path
            class="movement-diagram__arm"
            d="M244 294l-45-91M396 294l45-91"
          />
          <path class="movement-diagram__path" d="M201 258V174M439 258V174" />
          <circle cx="199" cy="202" r="8" />
          <circle cx="441" cy="202" r="8" />
        </svg>
      ) : (
        <>
          <img
            src={bodyPoster}
            width="720"
            height="960"
            alt="BodyParts3D anterior muscular-system evaluation render for anatomical context."
          />
        </>
      )
    }
    <figcaption>
      {
        isExercise ? (
          <>
            <span>Movement definition · static schematic</span>
            <small>Direction only · not a technique prescription</small>
          </>
        ) : (
          <>
            <span>Visual context · pectoral region</span>
            <small>Static evaluation plate · authoritative 2D fallback</small>
            <small>
              BodyParts3D, © The Database Center for Life Science licensed under
              CC Attribution 4.0 International
            </small>
          </>
        )
      }
    </figcaption>
  </figure>
</header>
