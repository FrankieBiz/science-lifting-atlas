---
interface Props {
  current?: 'home' | 'entity' | 'methodology' | undefined;
  rootHref: string;
}

const { current, rootHref } = Astro.props;
const evidenceHref = `${rootHref}#evidence-trace`;
---

<header class="site-header" aria-label="Site header">
  <a
    class="site-brand"
    href={rootHref}
    aria-label="Science-Based Lifting Atlas, home"
  >
    <span class="site-brand__mark" aria-hidden="true">SB</span>
    <span class="site-brand__name">
      <strong>Science-Based</strong>
      <small>Lifting Atlas</small>
    </span>
  </a>

  <nav aria-label="Primary navigation">
    <a href={rootHref} aria-current={current === 'home' ? 'page' : undefined}>
      <span>Explore</span>
    </a>
    <a href={evidenceHref}>
      <span>Evidence</span>
    </a>
    <a
      href={`${rootHref}methodology/`}
      aria-current={current === 'methodology' ? 'page' : undefined}
    >
      <span>How it works</span>
    </a>
  </nav>

  <div class="site-header__status">
    <span aria-hidden="true"></span>
    Slice 01 · review build
  </div>
</header>
